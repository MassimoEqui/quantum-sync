Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "Functions", " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"KP", "[", 
     RowBox[{"A_", ",", "B_"}], "]"}], ":=", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"A", ",", "B"}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"KPfromBits", "[", "l_", "]"}], ":=", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Apply", "[", 
      RowBox[{"KP", ",", 
       RowBox[{"l", " ", "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"0", "->", 
           RowBox[{"{", 
            RowBox[{"1", ",", "0"}], "}"}]}], ",", 
          RowBox[{"1", "->", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}]}]}], "}"}]}]}], "]"}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"UnifromSuperposFromBits", "[", "bitvectors__", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "v", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"SumVectorsFromBits", "[", "bits_", "]"}], ":=", 
        RowBox[{"KPfromBits", "[", "bits", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"SumVectorsFromBits", "[", 
         RowBox[{"bits_", ",", "list__"}], "]"}], ":=", 
        RowBox[{
         RowBox[{"KPfromBits", "[", "bits", "]"}], "+", 
         RowBox[{"SumVectorsFromBits", "[", "list", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"v", "=", 
        RowBox[{"SumVectorsFromBits", "[", "bitvectors", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"Total", "[", 
           RowBox[{"Unitize", "[", "v", "]"}], "]"}], "]"}]}], "*", 
        RowBox[{"Unitize", "[", "v", "]"}]}]}]}], "\[IndentingNewLine]", 
     "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"UviaSVD", "[", 
     RowBox[{"S_", ",", "T_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"M", ",", "U", ",", "\[CapitalSigma]", ",", "V"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"M", "=", 
        RowBox[{"T", ".", 
         RowBox[{"ConjugateTranspose", "[", "S", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"U", ",", "\[CapitalSigma]", ",", "V"}], "}"}], "=", 
        RowBox[{"SingularValueDecomposition", "[", "M", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"U", ".", 
