Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Define", " ", "your", " ", "matrices", " ", "S", " ", "and", 
    " ", "T"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"s", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";", "\n", 
    RowBox[{"t", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "*)"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"2.", " ", "Compute", " ", "the", " ", "product", " ", 
    RowBox[{"T", ".", "S"}], "*", 
    RowBox[{"(", 
     RowBox[{"Conjugate", " ", "Transpose", " ", "of", " ", "S"}], ")"}]}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"M", "=", 
     RowBox[{"T", ".", 
      RowBox[{"ConjugateTranspose", "[", "S", "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Perform", " ", "SVD", " ", "on", " ", "the", " ", "product"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"uSVD", ",", "w", ",", "vSVD"}], "}"}], "=", 
     RowBox[{"SingularValueDecomposition", "[", "M", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "4.", " ", "The", " ", "optimal", " ", "unitary", " ", "matrix", " ", "U",
      " ", "is", " ", 
     RowBox[{"uSVD", ".", "vSVD"}], "*"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"U", "=", 
     RowBox[{"UviaSVD", "[", 
      RowBox[{"S", ",", "T"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"5.", " ", "Verify", " ", "the", " ", "result"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"MatrixForm", "[", "U", "]"}], "\n", 
   RowBox[{"UnitaryMatrixQ", "[", "U", "]"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Should", " ", "return", " ", "True"}], "*)"}], "\n"}]}]], "Input",\

