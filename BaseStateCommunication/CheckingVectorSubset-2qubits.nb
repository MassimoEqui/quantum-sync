Cell[BoxData[
 RowBox[{
  RowBox[{"KPfromBits", "[", "bitvector_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"KPfb", "[", "b_", "]"}], ":=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"b", "==", "0"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"KPfb", "[", 
       RowBox[{"b_", ",", "bl__"}], "]"}], ":=", 
      RowBox[{"KP", "[", 
       RowBox[{
        RowBox[{"KPfb", "[", "b", "]"}], ",", 
        RowBox[{"KPfb", "[", "bl", "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Flatten", "[", 
      RowBox[{"KPfb", "@@", "bitvector"}], "]"}]}]}], "\[IndentingNewLine]", 
