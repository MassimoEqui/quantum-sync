Cell[BoxData[
 RowBox[{
  RowBox[{"UnifromSuperposFromBits", "[", 
   RowBox[{"{", "bitvectors__", "}"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "v", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"SumVectorsFromBits", "[", "bits_", "]"}], ":=", 
      RowBox[{"KPfromBits", "[", "bits", "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"SumVectorsFromBits", "[", 
       RowBox[{"bits_", ",", "list__"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"KPfromBits", "[", "bits", "]"}], "+", 
       RowBox[{"SumVectorsFromBits", "[", "list", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"v", "=", 
      RowBox[{"SumVectorsFromBits", "[", "bitvectors", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"Total", "[", 
         RowBox[{"Unitize", "[", "v", "]"}], "]"}], "]"}]}], "*", 
      RowBox[{"Unitize", "[", "v", "]"}]}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
