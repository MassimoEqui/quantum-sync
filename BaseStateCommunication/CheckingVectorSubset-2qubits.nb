Cell[BoxData[
 RowBox[{
  RowBox[{"UviaSVD", "[", 
   RowBox[{"S_", ",", "T_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"M", ",", "U", ",", "\[CapitalSigma]", ",", "V", ",", "n"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"If", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"ConjugateTranspose", "[", "S", "]"}], ".", "S"}], "==", 
       RowBox[{
        RowBox[{"ConjugateTranspose", "[", "T", "]"}], ".", "T"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"M", "=", 
        RowBox[{"T", ".", 
         RowBox[{"ConjugateTranspose", "[", "S", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"U", ",", "\[CapitalSigma]", ",", "V"}], "}"}], "=", 
        RowBox[{"SingularValueDecomposition", "[", "M", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"U", ".", 
        RowBox[{"ConjugateTranspose", "[", "V", "]"}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "S", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", "n", "}"}], ",", 
         RowBox[{"{", "n", "}"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}],
    "\[IndentingNewLine]", "]"}]}]], "Input",
